# Copier en .env et remplacer les valeurs : cp .env.example .env
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=clickfast

WEB_PORT=8080
# Le jeu appelle l'API sur le port 3000 (voir web/script.js) : ne pas changer seul.
API_PORT=3000
STATS_PORT=5000
ADMINER_PORT=8081

# Pour docker-compose.prod.yml : ton compte Docker Hub et la version publiée
REGISTRY_USER=ton-compte-dockerhub
TAG=1.0.0
